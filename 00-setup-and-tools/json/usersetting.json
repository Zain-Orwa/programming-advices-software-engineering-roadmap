{
    "files.autoSave": "afterDelay",

    // ── 42 / C++ specific ────────────────────────────────────────
    "C_Cpp.default.compilerPath": "/usr/bin/clang++",
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "notebook.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,

    "[c]": {
        "editor.defaultFormatter": "keyhr.42-c-format"
    },

    "cFormatter42.executablePath": "/Users/zain/.local/bin/c_formatter_42",
    "42header.email": "zorwa@student.42vienna.com",
    "42header.username": "zorwa",

    // ── Code Runner ──────────────────────────────────────────────
    "code-runner.clearPreviousOutput": true,
    "code-runner.runInTerminal": true,
    "code-runner.saveFileBeforeRun": true,

    // ── Git ──────────────────────────────────────────────────────
    "git.openRepositoryInParentFolders": "always",
    "git.autofetch": true,
    "git.enabled": true,
    "scm.diffDecorations": "all",
    "scm.diffDecorationsGutterWidth": 2,

    // ── Misc ─────────────────────────────────────────────────────
    "workbench.editorAssociations": {
        "*.pptx": "default"
    },
    "makefile.configureOnOpen": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,

    // ── Vim emulation ────────────────────────────────────────────
    "vim.enable": true,
    "vim.useSystemClipboard": true,
    "vim.hlsearch": true,
    "vim.smartRelativeLine": true,

    "vim.insertModeKeyBindings": [
        {
            "before": ["j", "j"],
            "after": ["<Esc>"]
        },
        {
            "before": ["j", "k"],
            "after": ["<Esc>"]
        }
    ],

    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["<C-s>"],
            "commands": ["workbench.action.files.save"]
        },
        {
            "before": ["<F5>"],
            "commands": ["workbench.action.tasks.runTask"],
            "args": "Build & Run C++"
        },
        {
            "before": ["\\", "h"],
            "commands": ["editor.action.insertSnippet"],
            "args": {
                "name": "File Header"
            }
        }
    ],

    "vim.insertModeKeyBindingsNonRecursive": [
        {
            "before": ["<C-s>"],
            "commands": ["workbench.action.files.save"]
        }
    ],

    // ── Editor look & feel ───────────────────────────────────────
    "editor.lineNumbers": "relative",
    "editor.cursorBlinking": "solid",
    "editor.cursorStyle": "block",
    "editor.scrollBeyondLastLine": false,
    "editor.scrolloff": 4,
    "editor.cursorSurroundingLines": 4,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.renderWhitespace": "boundary",
    "editor.fontFamily": "JetBrains Mono, Menlo, Monaco, monospace",
    "editor.guides.indentation": true,

    // ── Theme ────────────────────────────────────────────────────
    "workbench.colorTheme": "One Dark Pro",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.editor.showTabs": "multiple",
    "workbench.statusBar.visible": true,

    "editor.tokenColorCustomizations": {
        "comments": "#6b6b6b"
    },

    // ── Auto-pairs ───────────────────────────────────────────────
    "editor.autoClosingBrackets": "always",
    "editor.autoClosingQuotes": "always",
    "editor.autoSurround": "languageDefined",

    // ── Autocomplete ─────────────────────────────────────────────
    "editor.suggestOnTriggerCharacters": true,
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "on"
    },
    "editor.acceptSuggestionOnEnter": "off",
    "editor.tabCompletion": "on",

    // ── Terminal ─────────────────────────────────────────────────
    "terminal.integrated.defaultProfile.osx": "zsh",

    // ── File behavior ────────────────────────────────────────────
    "files.hotExit": "off",
    "workbench.editor.empty.hint": "hidden",
    "editor.minimap.enabled": false,
    "chat.disableAIFeatures": true
}